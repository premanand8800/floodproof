# Copy to .env (never commit .env). Every key is optional; adapters without a key log "skipped (no key)".
OPENROUTER_API_KEY=        # Muse Spark clues + agent
TAVILY_API_KEY=            # Tavily text search candidates
GOOGLE_API_KEY=            # Google Cloud Vision WEB_DETECTION (source "gvision") + YouTube Data API v3 search (source "youtube_api")
SERPAPI_KEY=               # SerpApi google_lens on the best keyframe (source "lens"); needs a publicly served run dir, 1 call per investigation
RELIEFWEB_APPNAME=         # approved ReliefWeb v2 appname (request at https://apidoc.reliefweb.int/parameters#appname); default "floodproof" is likely refused
FLOODPROOF_PUBLIC_BASE=    # optional, default https://floodproof.aether-soft.tech (where /files/run/<id>/frames/*.jpg is served)
